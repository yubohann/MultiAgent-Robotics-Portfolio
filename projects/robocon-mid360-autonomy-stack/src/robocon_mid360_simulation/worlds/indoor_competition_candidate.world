<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="indoor_competition_candidate">
    <!-- RoboCon25_Field is the single court asset and already contains both
         rule-aligned hoops at x=+/-6.2 m. Do not include hoop1/hoop2 again. -->
    <include><uri>model://RoboCon25_Field</uri></include>
    <!-- Venue shell stays outside the 22.5 m x 11.5 m field asset. These
         walls are not gameplay boundaries and do not create a second court. -->
    <model name="venue_north_wall">
      <static>true</static><pose>0 6.8 2.0 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>25 0.15 4</size></box></geometry></collision></link>
    </model>
    <model name="venue_south_wall">
      <static>true</static><pose>0 -6.8 2.0 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>25 0.15 4</size></box></geometry></collision></link>
    </model>
    <model name="venue_east_wall">
      <static>true</static><pose>12.5 0 2.0 0 0 1.5708</pose>
      <link name="link"><collision name="collision"><geometry><box><size>13.6 0.15 4</size></box></geometry></collision></link>
    </model>
    <model name="venue_west_wall">
      <static>true</static><pose>-12.5 0 2.0 0 0 1.5708</pose>
      <link name="link"><collision name="collision"><geometry><box><size>13.6 0.15 4</size></box></geometry></collision></link>
    </model>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.8 0.8 0.8 1</background>
      <shadows>1</shadows>
    </scene>
    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
  </world>
</sdf>
