<?xml version="1.0"?>
<package format="3">
  <name>mid360_localization_contract</name>
  <version>0.1.0</version>
  <description>ROS 2 interface, validation, and localization-anchor nodes for a Livox MID-360 deployment.</description>
  <maintainer email="replace-before-deployment@example.invalid">ROBOCON2025 team</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>livox_ros_driver2</depend>
  <depend>nav_msgs</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>

  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
