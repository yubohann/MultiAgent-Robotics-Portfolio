# Flask
SECRET_KEY=dev-secret-key

# LLM (SiliconFlow)
LLM_PROVIDER=siliconflow
LLM_API_KEY=sk-your-siliconflow-api-key
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_CHAT_PATH=/chat/completions
LLM_MODEL=deepseek-ai/DeepSeek-V3
LLM_TIMEOUT=30

# Optional site metadata for provider analytics
LLM_SITE_URL=http://localhost:5000
LLM_SITE_NAME=supermarket-management-system

# Logging
LOG_FILE=log/app.log
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
