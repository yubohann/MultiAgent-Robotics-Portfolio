        "control_latency": "one-step-command-latency-v1",
        "agent_dropout": "no-agent-dropout-v1"
      },
      "minimum_attempts": 4,
      "minimum_admitted": 4
    },
    {
      "cell_id": "validation-citylite-direct-v2",
      "split": "validation",
      "conditions": {
        "layout": "citylite-v1",
        "route": "fixed-public-route-v1",
        "route_family": "citylite-route-family-b-v1",
        "target_count": "object-count-4-v1",
        "height": "citylite-command-altitude-v1",
        "region": "citylite-command-volume-v1",
        "dynamics": "cf2x-nominal-v1",
        "initial_condition": "public-route-anchor-v1",
        "start_anchor": "citylite-start-anchor-b-v1",
        "target_region": "citylite-target-region-a-v1",
        "visibility_bucket": "direct-visible-v1",
        "communication": "synchronous-public-broadcast-v1",
        "control_latency": "one-step-command-latency-v1",
        "agent_dropout": "no-agent-dropout-v1"
      },
      "minimum_attempts": 4,
      "minimum_admitted": 4
    }
  ],
  "randomization": {
    "seed_derivation": "identity_utf8_lines_uint32_v1",
    "episode_seed_start": 20260727,
    "paired_initial_conditions": false
  },
  "analysis_plan": {
    "quota_basis": "coverage_quality_cost_pilot",
    "initial_admitted_episode_target": 8,
    "sample_size_reestimate_after_admitted": 8,
    "policy_ranking": false,
    "power_analysis_status": "not_applicable_to_t1_policy_ranking",
    "active_visibility_strata": [
      "direct-visible-v1"
    ],
    "unsupported_visibility_strata": [
      "partial-visible-v1"
    ],
    "primary_outputs": [
      "sensor_quality",
      "route_coverage",
      "visibility_stratum_realization",
      "failure_rate",
      "episode_bytes"
    ]
  },
  "overview_retention": {
    "selection_rule": "first_each_fixed_retained_frame_stride_and_final",
    "frame_index_stride": 10,
    "fixed_world_camera": true,
    "outcome_independent": true,
    "stored_modalities": [
      "rgb",
      "semantic",
      "world_pose"
    ],
    "runtime_only_modalities": [
      "depth"
    ]
  },
  "quality_acceptance": [
    "independent_validation_passed",
    "sensor_timestamps_synchronized",
    "action_before_step_causality",
    "camera_pose_closure",
    "visual_intrusion_absent",
    "physical_safety_passed",
    "condition_realization_passed",
    "artifact_identity_binding_passed"
  ],
  "exclusion_rules": [
    "reject_missing_sensor_frame",
    "reject_pose_closure_failure",
    "reject_visual_intrusion",
    "reject_condition_realization",
    "retain_failed_attempt_in_ledger"
  ]
}
