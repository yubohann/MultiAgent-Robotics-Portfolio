{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rivermark-benchmark.org/schemas/label_ontology_v1.schema.json",
  "title": "Rivermark Label Ontology v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ontology_id",
    "version",
    "coordinate_frame",
    "instance_policy",
    "distribution",
    "classes"
  ],
  "properties": {
    "schema": {"const": "org.rivermark.benchmark.label-ontology.v1"},
    "ontology_id": {"$ref": "#/$defs/id"},
    "version": {"$ref": "#/$defs/version"},
    "coordinate_frame": {"const": "world_rivermark_v1"},
    "instance_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_key", "scope", "class_immutable"],
      "properties": {
        "identity_key": {"const": "instance_id"},
        "scope": {"const": "episode"},
        "class_immutable": {"const": true}
      }
    },
    "distribution": {"enum": ["development_only", "cleared_public"]},
    "classes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/class"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "class": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class_id", "category", "geometry_types"],
      "properties": {
        "class_id": {"$ref": "#/$defs/id"},
        "category": {"enum": ["object", "obstacle", "landmark"]},
        "geometry_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["point3d", "bbox3d", "bbox2d", "mask2d", "polyline3d"]}
        }
      }
    }
  }
}
