{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rivermark-benchmark.org/schemas/episode_manifest_v1.schema.json",
  "title": "Rivermark Benchmark Episode Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "dataset_version",
    "episode_id",
    "split",
    "layout",
    "task",
    "timebase",
    "coordinate_frames",
    "streams",
    "policy_visible",
    "learning_labels",
    "evaluator_private",
    "provenance",
    "quality"
  ],
  "properties": {
    "schema": {
      "const": "org.rivermark.benchmark.episode.v1"
    },
    "dataset_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "episode_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "split": {
      "enum": ["pilot", "train", "inner_dev", "validation", "blind_test", "ood_test"]
    },
    "collection_binding": {
      "$ref": "#/$defs/collectionBinding"
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layout_id",
        "layout_hash",
        "layout_lineage_hash",
        "scene_manifest_ref",
        "scene_manifest_sha256"
      ],
      "properties": {
        "layout_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "layout_hash": {"$ref": "#/$defs/sha256"},
        "layout_lineage_hash": {"$ref": "#/$defs/sha256"},
        "scene_manifest_ref": {"$ref": "#/$defs/relativePath"},
        "scene_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "task_variant_id",
        "task_spec_ref",
        "task_spec_sha256",
        "information_profile",
        "observation_scope",
        "agent_count"
      ],
      "properties": {
        "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
        "task_variant_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
        "task_spec_ref": {"$ref": "#/$defs/relativePath"},
        "task_spec_sha256": {"$ref": "#/$defs/sha256"},
        "information_profile": {
          "enum": [
            "geometry_state",
            "state_only",
            "egocentric_rgb_state",
            "egocentric_rgbd_state",
            "language_rgbd_state",
            "multisensor_rgbd_lidar_imu_state",
            "multisensor_rgbd_lidar_radar_state",
            "language_multisensor_rgbd_lidar_radar_state"
          ]
        },
        "observation_scope": {
          "enum": ["decentralized_explicit_comm", "centralized_team_state"]
        },
        "agent_count": {"type": "integer", "minimum": 1, "maximum": 32}
      }
    },
    "timebase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "physics_dt_ns", "proprioception_period_ns", "camera_period_ns"],
      "properties": {
        "unit": {"const": "ns"},
        "physics_dt_ns": {"type": "integer", "minimum": 1},
        "proprioception_period_ns": {"type": "integer", "minimum": 1},
        "camera_period_ns": {"type": "integer", "minimum": 1}
      }
    },
    "coordinate_frames": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handedness",
        "world_up_axis",
        "world_frame_convention",
        "body_frame_convention",
        "camera_optical_frame_convention",
        "length_unit",
        "angle_unit",
        "quaternion_order",
        "transform_notation"
      ],
      "properties": {
        "handedness": {"const": "right"},
        "world_up_axis": {"const": "+z"},
        "world_frame_convention": {"const": "x_east_y_north_z_up"},
        "body_frame_convention": {"const": "flu"},
        "camera_optical_frame_convention": {"const": "opencv_x_right_y_down_z_forward"},
        "length_unit": {"const": "m"},
        "angle_unit": {"const": "rad"},
        "quaternion_order": {"const": "wxyz"},
        "transform_notation": {"const": "T_parent_child"}
      }
    },
    "observation_abi": {
      "$ref": "#/$defs/observationAbiRef"
    },
    "streams": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/streamRef"}
    },
    "policy_visible": {
      "type": "object",
      "additionalProperties": true,
      "required": ["information_profile", "modalities"],
      "properties": {
        "information_profile": {
          "enum": [
            "geometry_state",
            "state_only",
            "egocentric_rgb_state",
            "egocentric_rgbd_state",
            "language_rgbd_state",
            "multisensor_rgbd_lidar_imu_state",
            "multisensor_rgbd_lidar_radar_state",
            "language_multisensor_rgbd_lidar_radar_state"
          ]
        },
        "modalities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "learning_labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distributed", "modalities"],
      "properties": {
        "distributed": {"type": "boolean"},
        "modalities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "evaluator_private": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distributed", "server_only", "manifest_sha256"],
      "properties": {
        "distributed": {"type": "boolean"},
        "server_only": {"type": "boolean"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_conditioning",
        "observation_generation",
        "collector_type",
        "policy_id",
        "code_commit",
        "simulator_build",
        "scene_asset_license_status"
      ],
      "properties": {
        "route_conditioning": {"const": "public_only"},
        "observation_generation": {"const": "online_runtime"},
        "collector_type": {
          "enum": ["classical", "random", "qd", "rl", "human", "scripted", "mixed"]
        },
        "policy_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "code_commit": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
        "simulator_build": {"type": "string", "minLength": 1, "maxLength": 256},
        "scene_asset_license_status": {"enum": ["pending", "internal_only", "redistribution_cleared"]}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recording_valid",
        "task_success",
        "invalid_reasons",
        "frame_completeness_ratio",
        "timestamp_monotonic",
        "pose_closure_max_error_m"
      ],
      "properties": {
        "recording_valid": {"type": "boolean"},
        "task_success": {"type": "boolean"},
        "invalid_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "frame_completeness_ratio": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "timestamp_monotonic": {"type": "boolean"},
        "pose_closure_max_error_m": {"type": "number", "minimum": 0.0}
      }
    }
  },
  "$defs": {
    "collectionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_id", "protocol_sha256", "cell_id", "split", "episode_index", "episode_seed"],
      "properties": {
        "protocol_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
        "protocol_sha256": {"$ref": "#/$defs/sha256"},
        "cell_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
        "split": {"enum": ["train", "inner_dev", "validation", "blind_test", "ood_test"]},
        "episode_index": {"type": "integer", "minimum": 0},
        "episode_seed": {"type": "integer", "minimum": 0, "maximum": 4294967295}
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
    },
    "observationAbiRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "streamRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream_id",
        "partition",
        "modality",
        "media_type",
        "sample_count",
        "timestamp_field"
      ],
      "properties": {
        "stream_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
        "partition": {"enum": ["policy_visible", "learning_labels", "evaluator_private"]},
        "modality": {"type": "string", "minLength": 1, "maxLength": 128},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "sample_count": {"type": "integer", "minimum": 0},
        "timestamp_field": {"type": "string", "minLength": 1, "maxLength": 128},
        "agent_id": {"type": "integer", "minimum": 0, "maximum": 31},
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "path_template": {"$ref": "#/$defs/relativePath"},
        "content_hash_index_path": {"$ref": "#/$defs/relativePath"},
        "content_hash_index_sha256": {"$ref": "#/$defs/sha256"}
      },
      "oneOf": [
        {
          "required": ["path", "sha256"],
          "not": {
            "anyOf": [
              {"required": ["path_template"]},
              {"required": ["content_hash_index_path"]},
              {"required": ["content_hash_index_sha256"]}
            ]
          }
        },
        {
          "required": ["path_template", "content_hash_index_path", "content_hash_index_sha256"],
          "properties": {
            "path_template": {"pattern": "\\{agent_id\\}"}
          },
          "not": {
            "anyOf": [
              {"required": ["path"]},
              {"required": ["sha256"]}
            ]
          }
        }
      ]
    }
  }
}
