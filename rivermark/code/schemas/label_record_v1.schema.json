{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rivermark-benchmark.org/schemas/label_record_v1.schema.json",
  "title": "Rivermark Label Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ontology_id",
    "ontology_version",
    "episode_id",
    "frame_index",
    "timestamp_ns",
    "source_capture_receipt_sha256",
    "source_revision",
    "labels"
  ],
  "properties": {
    "schema": {"const": "org.rivermark.benchmark.label-record.v1"},
    "ontology_id": {"$ref": "#/$defs/id"},
    "ontology_version": {"$ref": "#/$defs/version"},
    "episode_id": {"$ref": "#/$defs/id"},
    "frame_index": {"type": "integer", "minimum": 0},
    "timestamp_ns": {"type": "integer", "minimum": 0},
    "source_capture_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "labels": {
      "type": "array",
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/label"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "vector3": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}],
      "items": false
    },
    "vector4": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}],
      "items": false
    },
    "quaternion": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}],
      "items": false
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_id",
        "class_id",
        "partition",
        "geometry",
        "visibility",
        "visible_fraction",
        "uncertainty",
        "annotation"
      ],
      "properties": {
        "instance_id": {"$ref": "#/$defs/id"},
        "class_id": {"$ref": "#/$defs/id"},
        "partition": {"const": "learning_labels"},
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "frame_id"],
          "properties": {
            "type": {"enum": ["point3d", "bbox3d", "bbox2d", "mask2d", "polyline3d"]},
            "frame_id": {"enum": ["world", "camera_optical", "body"]},
            "position_m": {"$ref": "#/$defs/vector3"},
            "center_m": {"$ref": "#/$defs/vector3"},
            "dimensions_m": {"$ref": "#/$defs/vector3"},
            "orientation_wxyz": {"$ref": "#/$defs/quaternion"},
            "xywh_px": {
              "type": "array",
              "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}],
              "items": false
            },
            "mask_path": {"type": "string", "minLength": 1},
            "mask_sha256": {"$ref": "#/$defs/sha256"},
            "width_px": {"type": "integer", "minimum": 1},
            "height_px": {"type": "integer", "minimum": 1},
            "points_m": {
              "type": "array",
              "minItems": 2,
              "items": {"$ref": "#/$defs/vector3"}
            }
          }
        },
        "visibility": {"enum": ["visible", "partially_occluded", "occluded", "out_of_view"]},
        "visible_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "uncertainty": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {"enum": ["not_available", "estimated", "measured"]},
            "confidence": {"type": "number", "minimum": 0, "maximum": 1},
            "position_std_m": {"$ref": "#/$defs/vector3"},
            "extent_std_m": {"$ref": "#/$defs/vector3"},
            "pixel_std_px": {"$ref": "#/$defs/vector4"},
            "orientation_std_rad": {"type": "number", "minimum": 0}
          }
        },
        "annotation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "status", "annotator_count"],
          "properties": {
            "source": {"enum": ["simulator_semantic", "simulator_geometry", "human_annotated", "derived"]},
            "status": {"enum": ["unreviewed", "reviewed", "adjudicated"]},
            "annotator_count": {"type": "integer", "minimum": 0},
            "agreement": {"type": "number", "minimum": 0, "maximum": 1},
            "known_error_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
          }
        }
      }
    }
  }
}
