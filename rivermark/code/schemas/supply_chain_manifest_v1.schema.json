{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rivermark-benchmark.org/schemas/supply_chain_manifest_v1.schema.json",
  "title": "Rivermark Supply-Chain Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "manifest_version", "release_id", "created_at", "assets", "runtime_dependencies", "sbom", "signature"],
  "properties": {
    "schema": {"const": "org.rivermark.benchmark.supply-chain.v1"},
    "manifest_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "release_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "created_at": {"type": "string", "minLength": 1},
    "assets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/asset"}},
    "runtime_dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
    "sbom": {"$ref": "#/$defs/sbom"},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "kind", "sha256", "license_spdx", "license_status", "redistributable", "attribution"],
      "properties": {
        "asset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
        "kind": {"type": "string", "enum": ["code", "scene_layer", "robot_asset", "runtime", "checkpoint", "label", "video", "data"]},
        "path": {"type": "string", "minLength": 1},
        "source_uri": {"type": "string", "format": "uri"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "license_spdx": {"type": "string", "minLength": 1},
        "license_status": {"type": "string", "enum": ["pending", "internal_only", "redistribution_cleared", "not_applicable"]},
        "redistributable": {"type": "boolean"},
        "attribution": {"type": "string", "minLength": 1},
        "decision_record": {"$ref": "#/$defs/decisionRecord"}
      },
      "allOf": [
        {
          "if": {"properties": {"license_status": {"const": "redistribution_cleared"}}, "required": ["license_status"]},
          "then": {"required": ["decision_record"]},
          "else": {"not": {"required": ["decision_record"]}}
        }
      ]
    },
    "decisionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "approved_by", "approved_at", "evidence_sha256"],
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "approved_by": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "minLength": 1},
        "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "license_spdx"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "license_spdx": {"type": "string", "minLength": 1},
        "source_uri": {"type": "string", "format": "uri"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "sbom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "status", "sha256"],
      "properties": {
        "format": {"type": "string", "enum": ["cyclonedx-json", "spdx-json"]},
        "status": {"type": "string", "enum": ["missing", "present", "verified"]},
        "path": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "format": "uri"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "spec_version": {"type": "string", "enum": ["1.6", "1.7"]},
        "generator": {"type": "string", "minLength": 1}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "enum": ["unsigned", "attestation_only", "cryptographically_verified"]},
        "algorithm": {"type": "string", "enum": ["ed25519", "minisign", "sigstore"]},
        "key_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "format": "uri"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "public_key_path": {"type": "string", "minLength": 1},
        "public_key_uri": {"type": "string", "format": "uri"},
        "public_key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
