{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aerocitybench.org/schemas/fault_spec_v1.schema.json",
  "title": "AeroCityBench evaluator-private FaultSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "type",
    "affected_drone_ids",
    "method_observability",
    "onset_fraction",
    "recoverable"
  ],
  "properties": {
    "profile": {"type": "string", "minLength": 1},
    "type": {
      "enum": [
        "none",
        "temporary_communication_isolation",
        "hard_loss",
        "observation_channel_loss"
      ]
    },
    "affected_drone_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^uav-[0-9]{2}$"}
    },
    "method_observability": {
      "const": "health_signals_only_no_evaluator_truth"
    },
    "onset_fraction": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "recoverable": {"type": "boolean"},
    "duration_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "channel": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "observation_channel_loss"}}},
      "then": {"required": ["channel"]},
      "else": {"not": {"required": ["channel"]}}
    }
  ]
}
