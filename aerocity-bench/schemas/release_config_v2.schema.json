{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aerocitybench.org/schemas/release_config_v2.schema.json",
  "title": "AeroCityBench release configuration v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "release_version",
    "generator_version",
    "master_seed",
    "core_sizes_m",
    "scale_ood_size_m",
    "split_counts",
    "episodes_per_layout",
    "target_count_ranges",
    "training_families",
    "topology_holdout_family",
    "visual_assets",
    "fleet",
    "evaluation_tracks",
    "observation_contract",
    "dynamics",
    "target_processes",
    "faults",
    "admission"
  ],
  "properties": {
    "schema": {"const": "org.aerocity.bench.release.v2"},
    "release_version": {"type": "string", "minLength": 1},
    "generator_version": {"type": "string", "minLength": 1},
    "master_seed": {"type": "integer", "minimum": 0},
    "core_sizes_m": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 48, "maximum": 160}
    },
    "scale_ood_size_m": {"type": "integer", "minimum": 64, "maximum": 224},
    "split_counts": {"$ref": "#/$defs/splitPositiveIntegers"},
    "episodes_per_layout": {"$ref": "#/$defs/splitPositiveIntegers"},
    "target_count_ranges": {"type": "object", "minProperties": 2},
    "training_families": {"type": "array", "minItems": 1, "uniqueItems": true},
    "topology_holdout_family": {"type": "string", "minLength": 1},
    "visual_assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle", "standard"],
      "properties": {
        "bundle": {"type": "string", "minLength": 1},
        "standard": {"type": "array", "minItems": 1, "uniqueItems": true}
      }
    },
    "fleet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "count"],
      "properties": {
        "profile": {"type": "string", "minLength": 1},
        "count": {"type": "integer", "minimum": 1, "maximum": 32}
      }
    },
    "evaluation_tracks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_task", "task_views", "fleet"],
      "properties": {
        "primary_task": {"const": "geometry-search-3d"},
        "task_views": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exploration-3d", "geometry-search-3d", "perception-search-3d"],
          "properties": {
            "exploration-3d": {"const": "supported"},
            "geometry-search-3d": {"const": "primary"},
            "perception-search-3d": {"const": "optional"}
          }
        },
        "fleet": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "core_count",
            "scaling_counts",
            "resilience_count",
            "resilience_loss_counts",
            "conditional_stress_counts",
            "custom_count_range"
          ],
          "properties": {
            "core_count": {"type": "integer", "minimum": 1, "maximum": 32},
            "scaling_counts": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "integer", "minimum": 1, "maximum": 32}
            },
            "resilience_count": {"type": "integer", "minimum": 2, "maximum": 32},
            "resilience_loss_counts": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "integer", "minimum": 0, "maximum": 31}
            },
            "conditional_stress_counts": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "integer", "minimum": 1, "maximum": 32}
            },
            "custom_count_range": {
              "type": "array",
              "prefixItems": [
                {"type": "integer", "minimum": 1, "maximum": 32},
                {"type": "integer", "minimum": 1, "maximum": 32}
              ],
              "items": false
            }
          }
        }
      }
    },
    "observation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tiers",
        "leaderboards",
        "geometry_confirmation",
        "perception_confirmation",
        "cross_tier_ranking"
      ],
      "properties": {
        "tiers": {
          "const": [
            "T0_state_prior",
            "T1_occupancy_voxel",
            "T2_range_fov",
            "T3_rgbd",
            "T4_full_perception"
          ]
        },
        "leaderboards": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exploration-3d", "geometry-search-3d", "perception-search-3d"],
          "properties": {
            "exploration-3d": {"$ref": "#/$defs/observationTierList"},
            "geometry-search-3d": {"$ref": "#/$defs/observationTierList"},
            "perception-search-3d": {"const": ["T4_full_perception"]}
          }
        },
        "geometry_confirmation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_range_m",
            "horizontal_fov_deg",
            "vertical_fov_deg",
            "minimum_dwell_s",
            "require_line_of_sight",
            "require_surface_facing",
            "require_source_observation_id",
            "allow_distance_only"
          ],
          "properties": {
            "max_range_m": {"type": "number", "exclusiveMinimum": 0},
            "horizontal_fov_deg": {"type": "number", "exclusiveMinimum": 0, "maximum": 180},
            "vertical_fov_deg": {"type": "number", "exclusiveMinimum": 0, "maximum": 180},
            "minimum_dwell_s": {"type": "number", "exclusiveMinimum": 0},
            "require_line_of_sight": {"const": true},
            "require_surface_facing": {"const": true},
            "require_source_observation_id": {"const": true},
            "allow_distance_only": {"const": false}
          }
        },
        "perception_confirmation": {
          "const": {
            "requires_detector_output": true,
            "separate_leaderboard": true,
            "geometry_oracle_autofill": false
          }
        },
        "cross_tier_ranking": {"const": "forbidden"}
      }
    },
    "dynamics": {"type": "object"},
    "target_processes": {"type": "object"},
    "faults": {"type": "object"},
    "admission": {"type": "object"}
  },
  "$defs": {
    "splitPositiveIntegers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "train",
        "validation",
        "test_iid",
        "test_topology",
        "test_target_process",
        "test_resilience",
        "test_scale"
      ],
      "properties": {
        "train": {"type": "integer", "minimum": 1},
        "validation": {"type": "integer", "minimum": 1},
        "test_iid": {"type": "integer", "minimum": 1},
        "test_topology": {"type": "integer", "minimum": 1},
        "test_target_process": {"type": "integer", "minimum": 1},
        "test_resilience": {"type": "integer", "minimum": 1},
        "test_scale": {"type": "integer", "minimum": 1}
      }
    },
    "observationTierList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "T0_state_prior",
          "T1_occupancy_voxel",
          "T2_range_fov",
          "T3_rgbd",
          "T4_full_perception"
        ]
      }
    }
  }
}
