{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aerocitybench.org/schemas/episode_private_v2.schema.json",
  "title": "AeroCityBench evaluator-private episode v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "layout_id",
    "layout_hash",
    "episode_index",
    "episode_seed",
    "condition_group_id",
    "target_process",
    "target_count",
    "targets",
    "fleet_profile",
    "dynamics_profile",
    "starts",
    "fault_spec",
    "smoke",
    "communication",
    "energy_budget_j",
    "episode_hash"
  ],
  "properties": {
    "schema": {"const": "org.aerocity.bench.episode-private.v2"},
    "layout_id": {"type": "string"},
    "layout_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "episode_index": {"type": "integer", "minimum": 0},
    "episode_seed": {"type": "integer", "minimum": 0},
    "condition_group_id": {"type": "string", "minLength": 1},
    "target_process": {
      "enum": ["uniform_surface", "clustered_surface", "height_stratified"]
    },
    "target_count": {"type": "integer", "minimum": 1},
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_id", "site_id", "support_class", "altitude_band", "position", "normal"],
        "properties": {
          "target_id": {"type": "string"},
          "site_id": {"type": "string"},
          "support_class": {"enum": ["roof", "opening", "entrance", "rubble"]},
          "altitude_band": {"enum": ["near_ground", "lower", "mid", "elevated", "highrise"]},
          "position": {"$ref": "#/$defs/vector3"},
          "normal": {"$ref": "#/$defs/vector3"}
        }
      }
    },
    "fleet_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "count"],
      "properties": {
        "name": {"type": "string"},
        "count": {"type": "integer", "minimum": 1, "maximum": 32}
      }
    },
    "dynamics_profile": {"type": "string", "minLength": 1},
    "starts": {"type": "array", "minItems": 1},
    "fault_spec": {"$ref": "fault_spec_v1.schema.json"},
    "smoke": {"type": "object"},
    "communication": {"type": "object"},
    "energy_budget_j": {"type": "number", "exclusiveMinimum": 0},
    "episode_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "vector3": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}],
      "items": false
    }
  }
}
