<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robocon_mid360_simulation</name>
  <version>0.1.0</version>
  <description>ROS 2 Gazebo MID-360 simulation and public ROBOCON field asset profile.</description>
  <maintainer email="private@robocon.invalid">ROBOCON2025 team</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>
  <depend>gazebo_dev</depend>
  <depend>gazebo_msgs</depend>
  <depend>gazebo_ros</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>livox_ros_driver2</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>xacro</depend>
  <exec_depend>gazebo_ros_pkgs</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/models" gazebo_plugin_path="${prefix}/lib" />
  </export>
</package>
