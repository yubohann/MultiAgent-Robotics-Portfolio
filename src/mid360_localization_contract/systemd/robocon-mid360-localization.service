[Unit]
Description=ROBOCON MID-360 competition bringup
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=REPLACE_WITH_DEPLOY_USER
WorkingDirectory=/home/REPLACE_WITH_DEPLOY_USER/robocon_mid360_ws
Environment=ROBOCON_WS=/home/REPLACE_WITH_DEPLOY_USER/robocon_mid360_ws
Environment=ROBOCON_MAP_FILE=/home/REPLACE_WITH_DEPLOY_USER/robocon_mid360_ws/maps/field_v1.pcd
ExecStartPre=/usr/bin/test -r ${ROBOCON_WS}/config/MID360_config.local.json
ExecStartPre=/usr/bin/test -r ${ROBOCON_WS}/config/fast_lio_mid360.local.yaml
ExecStartPre=/usr/bin/test -r ${ROBOCON_WS}/config/mid360_competition.local.yaml
ExecStartPre=/usr/bin/test -r ${ROBOCON_MAP_FILE}
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && source "$ROBOCON_WS/install/setup.bash" && exec ros2 launch robocon_game_supervisor robocon_competition.launch.py start_driver:=true start_fast_lio:=true start_pose_bridge:=true start_target_gate:=true start_fixed_map_localizer:=true start_camera_yolo:=false driver_config_path:="$ROBOCON_WS/config/MID360_config.local.json" fast_lio_params_file:="$ROBOCON_WS/config/fast_lio_mid360.local.yaml" contract_params_file:="$ROBOCON_WS/config/mid360_competition.local.yaml" map_file:="$ROBOCON_MAP_FILE"'
Restart=on-failure
RestartSec=3
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
