# 飞书同步配置：复制本文件为 .env 并填写（不要提交 .env）

# 企业自建应用凭证（开放平台 open.feishu.cn → 你的应用 → 凭证与基础信息）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 目标知识库根节点
# 可以直接粘贴整个 wiki 链接，也可以只填最后一段 token
FEISHU_ROOT_NODE=https://xcnj1prjbgud.feishu.cn/wiki/UVDMwXLviixXqskzbZPcGNdqnHf

# 仅用于打印链接（可从上面的链接自动识别，一般不用改）
FEISHU_TENANT_DOMAIN=xcnj1prjbgud.feishu.cn

# 飞书开放平台地址（飞书国际版才需要改）
FEISHU_BASE_URL=https://open.feishu.cn
